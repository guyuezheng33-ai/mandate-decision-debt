{
  "name": "mandate-decision-debt",
  "version": "0.1.0",
  "private": true,
  "description": "Mandate — 每条工作项都应当能说出是谁、在哪份文档、什么时候授权了它。",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node verify.js",
    "demo": "node cli.js",
    "seed": "node seed/grade.js seed/seed-sheet.csv",
    "seed:dry": "node seed/grade.js seed/dry-run.json",
    "preview": "node preview/render.js",
    "preview:zh": "node preview/render.js --zh",
    "harness": "node preview/emit.js && esbuild src/ui/src/app.js --bundle --minify --format=iife --alias:@forge/bridge=./preview/dev/shim.js --outfile=preview/ui-harness.js",
    "ui:build": "esbuild src/ui/src/app.js --bundle --minify --format=iife --outfile=src/ui/index.js --log-level=warning",
    "build": "npm run ui:build && node verify.js",
    "marketplace": "node marketplace/check.js",
    "bench": "node bench.js",
    "manifest": "node manifest.check.js",
    "proof": "node proof.js",
    "corpus": "node tools/corpus-report.js",
    "eval": "node tools/authority-eval.js",
    "eval:incremental": "node tools/incremental-eval.js",
    "docs:sync": "node tools/sync-counts.js",
    "docs:check": "node tools/sync-counts.js --check",
    "check": "node tools/full-check.js",
    "submission": "node tools/submission-check.js",
    "ci": "npm run ui:build && node manifest.check.js && node verify.js && node bench.js",
    "ci:release": "node release.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "7.3.0",
    "@forge/resolver": "2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0"
  },
  "overrides": {
    "prosemirror-view": "1.43.0",
    "minimatch": "11.0.9",
    "glob": "14.0.6"
  }
}
